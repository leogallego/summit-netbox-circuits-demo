# NetBox Cloud
NETBOX_URL=https://your-instance.netboxcloud.com
NETBOX_TOKEN=your_netbox_api_token_here

# Ansible Automation Platform
AAP_URL=https://your-aap-instance.example.com
AAP_USERNAME=your_aap_username
AAP_PASSWORD=your_aap_password
# AAP Controller API token — used by the NetBox webhook to trigger the workflow.
# Generate via: AAP UI → Access → Users → Tokens.
AAP_TOKEN=your_aap_controller_token_here

# EDA event stream shared token (any strong random string — must match what is
# configured in EDA and sent by the NetBox webhook)
EDA_STREAM_TOKEN=your_eda_stream_token_here

# Container Registry — Quay.io (for pulling project EE images)
REGISTRY_HOST=quay.io
REGISTRY_USERNAME=your_registry_username
REGISTRY_PASSWORD=your_registry_password

# Container Registry — Red Hat (optional — for pulling EDA Decision Environment
# image from registry.redhat.io if not already present on AAP)
RH_REGISTRY_USERNAME=
RH_REGISTRY_PASSWORD=

# Automation Hub (for syncing certified collections)
AH_URL=https://console.redhat.com/api/automation-hub/
AH_TOKEN=your_automation_hub_token_here

# Report publishing — GitHub Pages (optional — leave empty to skip)
# Token needs contents:write scope on the target repo.
# Reports are published to the gh-pages branch root.
GITHUB_TOKEN=
GITHUB_REPO=leogallego/summit-netbox-circuits-demo

# Report publishing — SSH server (optional — leave empty to skip)
# Populated by setup_infra.sh after Terraform, or set manually.
REPORT_SERVER_HOST=
REPORT_SERVER_PORT=2222
REPORT_URL=
PRIVATE_KEY_PATH=

# Router (optional — populated by setup_infra.sh after Terraform)
# Leave empty to skip router registration.
ROUTER_IP=
ROUTER_PASSWORD=
ROUTER_USERNAME=iosuser
ROUTER_PRIMARY_GW=172.16.0.1
ROUTER_BACKUP_GW=172.16.1.1

# MCP Server (optional — for AI MCP integration)
# MCP_AAP_SERVER overrides the hostname derived from AAP_URL.
MCP_AAP_TOKEN=
MCP_AAP_SERVER=
MCP_AAP_PORT=8448
# Read-only NetBox API token for MCP server (separate from NETBOX_TOKEN)
MCP_NETBOX_TOKEN=
# Container runtime for NetBox MCP server (podman or docker)
MCP_CONTAINER_RUNTIME=podman
# Set to false only for self-signed certs in dev/demo environments
NETBOX_VERIFY_SSL=true
