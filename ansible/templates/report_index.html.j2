{# {{ ansible_managed }} #}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Circuit Failover Reports</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; background: #0D1B2A; color: #e2e8f0; padding: 2rem; }
  .container { max-width: 800px; margin: 0 auto; }
  h1 { font-size: 1.6rem; color: #00C2A8; margin-bottom: 0.25rem; }
  .subtitle { color: #B0BCCC; font-size: 0.85rem; margin-bottom: 2rem; }
  .card { background: #142A3E; border-radius: 8px; padding: 1.5rem; margin-bottom: 1rem; border: 1px solid #1e3a52; display: flex; justify-content: space-between; align-items: center; text-decoration: none; transition: border-color 0.2s; }
  .card:hover { border-color: #00C2A8; }
  .card .circuit { font-size: 1rem; font-weight: 600; color: #f8fafc; }
  .card .timestamp { font-size: 0.82rem; color: #B0BCCC; }
  .empty { color: #B0BCCC; font-style: italic; padding: 2rem; text-align: center; }
  .badge { display: inline-block; padding: 0.15rem 0.5rem; border-radius: 3px; font-size: 0.72rem; font-weight: 600; text-transform: uppercase; background: #052e16; color: #4ade80; margin-left: 0.5rem; }
</style>
</head>
<body>
<div class="container">
  <h1>Circuit Failover Reports</h1>
  <p class="subtitle">Automated incident reports generated by Ansible Automation Platform</p>
{% if report_files | length > 0 %}
{% set ns = namespace(items=[]) %}
{% for file in report_files %}
{% set ts = file.name.split('_') | last | replace('.html', '') %}
{% set ns.items = ns.items + [{'file': file, 'ts': ts}] %}
{% endfor %}
{% for item in ns.items | sort(attribute='ts', reverse=true) %}
{% set file = item.file %}
{% set parts = file.name | replace('failover_report_', '') | replace('.html', '') | split('_') %}
{% set circuit = parts[:-1] | join('_') %}
{% set ts_raw = parts[-1] | default('') %}
{% set ts_display = ts_raw[:4] ~ '-' ~ ts_raw[4:6] ~ '-' ~ ts_raw[6:8] ~ ' ' ~ ts_raw[9:11] ~ ':' ~ ts_raw[11:13] ~ ':' ~ ts_raw[13:15] if ts_raw | length >= 15 else ts_raw %}
  <a class="card" href="{{ file.name }}">
    <div>
      <span class="circuit">{{ circuit }}</span>
      <span class="badge">report</span>
    </div>
    <span class="timestamp">{{ ts_display }} UTC</span>
  </a>
{% endfor %}
{% else %}
  <p class="empty">No failover reports generated yet. Run the Circuit Failover Workflow to publish a report here.</p>
{% endif %}
</div>
</body>
</html>
